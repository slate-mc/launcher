# Non-secret production configuration for slate-modpack-api.
SLATE_DEPLOYMENT_ENVIRONMENT=production
SLATE_OTEL_ENABLED=true
SLATE_OTEL_SAMPLE_RATIO=0.1
SLATE_POSTHOG_HOST=https://us.i.posthog.com
SLATE_SUPPORT_REPORTS_BUCKET=slate-private-support
SLATE_SUPPORT_REPORTS_PREFIX=support-reports
AWS_DEFAULT_REGION=us-east-1

# Supply these through the deployment secret store. Never commit their values.
SLATE_SENTRY_DSN=secret-store:sentry-dsn
SLATE_POSTHOG_PROJECT_TOKEN=secret-store:posthog-project-token
OTEL_EXPORTER_OTLP_ENDPOINT=secret-store:otlp-endpoint
OTEL_EXPORTER_OTLP_HEADERS=secret-store:otlp-headers

# Use workload identity when the host supports it. Static S3-compatible credentials,
# when required, must also come from the deployment secret store.
AWS_ACCESS_KEY_ID=secret-store:object-storage-access-key
AWS_SECRET_ACCESS_KEY=secret-store:object-storage-secret-key
# AWS_ENDPOINT_URL_S3=https://account-id.r2.cloudflarestorage.com
