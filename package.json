{
  "name": "slate-workspace",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace @slate/desktop build",
    "dev": "yarn workspace @slate/desktop dev",
    "lint": "yarn workspace @slate/desktop lint",
    "test": "yarn workspace @slate/desktop test",
    "test:e2e": "yarn workspace @slate/desktop test:e2e",
    "tauri": "yarn workspace @slate/desktop tauri"
  }
}
