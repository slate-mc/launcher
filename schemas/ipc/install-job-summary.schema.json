{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallJobSummary",
  "type": "object",
  "properties": {
    "completedItems": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "createdAt": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "message": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "revisionId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "$ref": "#/$defs/InstallJobStateDto"
    },
    "totalItems": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "instanceId",
    "revisionId",
    "state",
    "phase",
    "message",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "InstallJobStateDto": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    }
  }
}
