{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallJobSummary",
  "type": "object",
  "properties": {
    "canRetry": {
      "type": "boolean"
    },
    "completedItems": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "createdAt": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "message": {
      "type": "string"
    },
    "operation": {
      "anyOf": [
        {
          "$ref": "#/$defs/InstallOperationDto"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "type": "string"
    },
    "queuePosition": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "revisionId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "$ref": "#/$defs/InstallJobStateDto"
    },
    "totalItems": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "instanceId",
    "revisionId",
    "state",
    "canRetry",
    "phase",
    "message",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "InstallJobStateDto": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "paused",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "InstallOperationDto": {
      "type": "string",
      "enum": [
        "instanceInstall",
        "contentInstall",
        "modInstall",
        "modUpdate",
        "modpackUpdate"
      ]
    }
  }
}
