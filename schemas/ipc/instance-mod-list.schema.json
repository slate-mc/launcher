{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_InstanceModSummary",
  "type": "array",
  "items": {
    "$ref": "#/$defs/InstanceModSummary"
  },
  "$defs": {
    "InstanceModOriginDto": {
      "type": "string",
      "enum": [
        "added",
        "modpack",
        "local"
      ]
    },
    "InstanceModSummary": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "filePath": {
          "type": "string"
        },
        "fileSize": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "iconUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "installedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/InstanceModOriginDto"
        },
        "pinned": {
          "type": "boolean"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "displayName",
        "filePath",
        "enabled",
        "pinned",
        "origin",
        "fileSize"
      ]
    },
    "Provider": {
      "type": "string",
      "enum": [
        "curseforge",
        "modrinth",
        "ftb"
      ]
    }
  }
}
