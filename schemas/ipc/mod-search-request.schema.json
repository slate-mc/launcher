{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModSearchRequest",
  "type": "object",
  "properties": {
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "page": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provider"
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "sort": {
      "$ref": "#/$defs/ModpackSortDto"
    }
  },
  "required": [
    "instanceId",
    "sort"
  ],
  "$defs": {
    "ModpackSortDto": {
      "type": "string",
      "enum": [
        "relevance",
        "downloads",
        "updated",
        "newest"
      ]
    },
    "Provider": {
      "type": "string",
      "enum": [
        "curseforge",
        "modrinth",
        "ftb"
      ]
    }
  }
}
