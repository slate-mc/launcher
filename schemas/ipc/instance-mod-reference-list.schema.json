{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_InstanceModReferenceSummary",
  "type": "array",
  "items": {
    "$ref": "#/$defs/InstanceModReferenceSummary"
  },
  "$defs": {
    "InstanceModReferenceSummary": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectId": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        }
      },
      "required": [
        "provider",
        "projectId"
      ]
    },
    "Provider": {
      "type": "string",
      "enum": [
        "curseforge",
        "modrinth",
        "ftb"
      ]
    }
  }
}
