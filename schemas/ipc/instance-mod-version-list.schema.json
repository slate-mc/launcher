{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModVersionList",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModVersionSummary"
      }
    }
  },
  "required": [
    "items"
  ],
  "$defs": {
    "ModVersionSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  }
}
