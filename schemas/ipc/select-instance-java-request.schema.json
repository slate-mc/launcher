{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelectInstanceJavaRequest",
  "type": "object",
  "properties": {
    "expectedRevision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "$ref": "#/$defs/JavaSelectionModeDto"
    }
  },
  "required": [
    "id",
    "mode",
    "expectedRevision"
  ],
  "$defs": {
    "JavaSelectionModeDto": {
      "type": "string",
      "enum": [
        "managed",
        "detected",
        "custom"
      ]
    }
  }
}
