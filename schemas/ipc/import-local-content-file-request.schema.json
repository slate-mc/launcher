{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportLocalContentFileRequest",
  "type": "object",
  "properties": {
    "expectedRevision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "$ref": "#/$defs/InstanceContentKindDto"
    },
    "worldName": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "instanceId",
    "kind",
    "expectedRevision"
  ],
  "$defs": {
    "InstanceContentKindDto": {
      "type": "string",
      "enum": [
        "resourcePack",
        "shaderPack",
        "dataPack"
      ]
    }
  }
}
