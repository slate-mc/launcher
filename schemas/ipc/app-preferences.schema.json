{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppPreferencesDto",
  "type": "object",
  "properties": {
    "crashReportingEnabled": {
      "type": "boolean"
    },
    "downloadBandwidthLimitMib": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "downloadConcurrency": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "reduceMotion": {
      "$ref": "#/$defs/ReduceMotionPreferenceDto"
    },
    "telemetryEnabled": {
      "type": "boolean"
    },
    "theme": {
      "$ref": "#/$defs/ThemePreferenceDto"
    },
    "trashRetentionDays": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "updateChannel": {
      "$ref": "#/$defs/UpdateChannelDto"
    }
  },
  "required": [
    "theme",
    "downloadConcurrency",
    "downloadBandwidthLimitMib",
    "telemetryEnabled",
    "crashReportingEnabled",
    "updateChannel",
    "reduceMotion",
    "trashRetentionDays"
  ],
  "$defs": {
    "ReduceMotionPreferenceDto": {
      "type": "string",
      "enum": [
        "system",
        "on",
        "off"
      ]
    },
    "ThemePreferenceDto": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "system"
      ]
    },
    "UpdateChannelDto": {
      "type": "string",
      "enum": [
        "stable",
        "beta"
      ]
    }
  }
}
