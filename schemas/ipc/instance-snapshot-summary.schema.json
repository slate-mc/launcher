{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstanceSnapshotSummary",
  "type": "object",
  "properties": {
    "createdAt": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "pinned": {
      "type": "boolean"
    },
    "sizeBytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "sizeBytes",
    "pinned",
    "createdAt"
  ]
}
