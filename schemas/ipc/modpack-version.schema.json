{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModpackVersion",
  "type": "object",
  "properties": {
    "changelog": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModpackFile"
      }
    },
    "id": {
      "type": "string"
    },
    "loader": {
      "$ref": "#/$defs/Loader"
    },
    "memory": {
      "$ref": "#/$defs/MemoryRecommendation"
    },
    "minecraft": {
      "$ref": "#/$defs/MinecraftTarget"
    },
    "name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    },
    "published_at": {
      "type": "string"
    },
    "release_type": {
      "$ref": "#/$defs/ReleaseType"
    },
    "total_download_size": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "provider",
    "project_id",
    "id",
    "name",
    "release_type",
    "minecraft",
    "loader",
    "memory",
    "files",
    "total_download_size",
    "published_at"
  ],
  "$defs": {
    "DownloadSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "direct"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "proxy"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        }
      ]
    },
    "FileOption": {
      "type": "object",
      "properties": {
        "default": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "default"
      ]
    },
    "Hashes": {
      "type": "object",
      "properties": {
        "sha1": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha512": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Loader": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/LoaderKind"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    "LoaderKind": {
      "type": "string",
      "enum": [
        "vanilla",
        "forge",
        "neoforge",
        "fabric",
        "quilt"
      ]
    },
    "MemoryRecommendation": {
      "type": "object",
      "properties": {
        "minimum_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "recommended_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "minimum_mb",
        "recommended_mb"
      ]
    },
    "MinecraftTarget": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ]
    },
    "ModpackFile": {
      "type": "object",
      "properties": {
        "download": {
          "$ref": "#/$defs/DownloadSource"
        },
        "hashes": {
          "$ref": "#/$defs/Hashes"
        },
        "id": {
          "type": "string"
        },
        "option": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileOption"
            },
            {
              "type": "null"
            }
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "$ref": "#/$defs/PackFileType"
        }
      },
      "required": [
        "id",
        "type",
        "path",
        "size",
        "hashes",
        "side",
        "optional",
        "download"
      ]
    },
    "PackFileType": {
      "type": "string",
      "enum": [
        "mod",
        "config",
        "resource_pack",
        "shader_pack",
        "data_pack",
        "library",
        "override",
        "archive",
        "other"
      ]
    },
    "Provider": {
      "type": "string",
      "enum": [
        "curseforge",
        "modrinth",
        "ftb"
      ]
    },
    "ProviderReference": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "project_id"
      ]
    },
    "ReleaseType": {
      "type": "string",
      "enum": [
        "release",
        "beta",
        "alpha",
        "unknown"
      ]
    },
    "Side": {
      "type": "string",
      "enum": [
        "both",
        "client",
        "server"
      ]
    }
  }
}
