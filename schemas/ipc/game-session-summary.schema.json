{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameSessionSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "logName": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "pid": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "state": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "instanceId",
    "state",
    "mode",
    "pid",
    "logName"
  ]
}
