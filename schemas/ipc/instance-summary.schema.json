{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstanceSummary",
  "type": "object",
  "properties": {
    "createdAt": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "lastPlayed": {
      "type": [
        "string",
        "null"
      ]
    },
    "loaderKind": {
      "$ref": "#/$defs/LoaderKindDto"
    },
    "loaderVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "managementMode": {
      "$ref": "#/$defs/ManagementModeDto"
    },
    "memoryMb": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "minecraftVersion": {
      "type": "string"
    },
    "modCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "mode": {
      "$ref": "#/$defs/InstanceModeDto"
    },
    "modpackSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModpackSourceSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "settings": {
      "$ref": "#/$defs/InstanceSettingsSummary"
    },
    "setupState": {
      "$ref": "#/$defs/InstanceSetupStateDto"
    },
    "storagePath": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "storagePath",
    "mode",
    "managementMode",
    "favorite",
    "revision",
    "minecraftVersion",
    "loaderKind",
    "memoryMb",
    "modCount",
    "setupState",
    "settings",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "InstanceModeDto": {
      "type": "string",
      "enum": [
        "vanilla",
        "modded",
        "pvp"
      ]
    },
    "InstanceSettingsSummary": {
      "type": "object",
      "properties": {
        "backupBeforeChanges": {
          "type": "boolean"
        },
        "backupRetention": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "bannerPositionX": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "bannerPositionY": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cpuAffinity": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0
          }
        },
        "customJavaLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "effectiveMemoryMb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "gameLanguage": {
          "type": "string"
        },
        "groupName": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasCustomBanner": {
          "type": "boolean"
        },
        "hasCustomIcon": {
          "type": "boolean"
        },
        "initialMemoryMb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "javaMode": {
          "$ref": "#/$defs/JavaSelectionModeDto"
        },
        "jvmArguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "launcherBehavior": {
          "$ref": "#/$defs/LauncherBehaviorDto"
        },
        "logRetentionDays": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "memoryMode": {
          "$ref": "#/$defs/MemoryModeDto"
        },
        "notes": {
          "type": "string"
        },
        "performancePreset": {
          "$ref": "#/$defs/PerformancePresetDto"
        },
        "preferredAccountId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "processPriority": {
          "$ref": "#/$defs/ProcessPriorityDto"
        },
        "quickPlayServer": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolutionHeight": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "resolutionWidth": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "windowMode": {
          "$ref": "#/$defs/InstanceWindowModeDto"
        }
      },
      "required": [
        "description",
        "notes",
        "tags",
        "hasCustomIcon",
        "hasCustomBanner",
        "bannerPositionX",
        "bannerPositionY",
        "windowMode",
        "launcherBehavior",
        "gameLanguage",
        "processPriority",
        "cpuAffinity",
        "memoryMode",
        "initialMemoryMb",
        "effectiveMemoryMb",
        "javaMode",
        "performancePreset",
        "jvmArguments",
        "environment",
        "backupBeforeChanges",
        "backupRetention",
        "logRetentionDays"
      ]
    },
    "InstanceSetupStateDto": {
      "type": "string",
      "enum": [
        "configured",
        "preparing",
        "ready",
        "blocked"
      ]
    },
    "InstanceWindowModeDto": {
      "type": "string",
      "enum": [
        "windowed",
        "maximized",
        "fullscreen"
      ]
    },
    "JavaSelectionModeDto": {
      "type": "string",
      "enum": [
        "managed",
        "detected",
        "custom"
      ]
    },
    "LauncherBehaviorDto": {
      "type": "string",
      "enum": [
        "keepOpen",
        "minimize",
        "hide"
      ]
    },
    "LoaderKindDto": {
      "type": "string",
      "enum": [
        "vanilla",
        "fabric",
        "neoForge"
      ]
    },
    "ManagementModeDto": {
      "type": "string",
      "enum": [
        "local",
        "community"
      ]
    },
    "MemoryModeDto": {
      "type": "string",
      "enum": [
        "auto",
        "custom"
      ]
    },
    "ModpackSourceSummary": {
      "type": "object",
      "properties": {
        "bannerUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "iconUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectId": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "versionId": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "projectId",
        "versionId",
        "displayName"
      ]
    },
    "PerformancePresetDto": {
      "type": "string",
      "enum": [
        "balanced",
        "throughput",
        "lowLatency",
        "custom"
      ]
    },
    "ProcessPriorityDto": {
      "type": "string",
      "enum": [
        "low",
        "belowNormal",
        "normal",
        "aboveNormal",
        "high"
      ]
    },
    "Provider": {
      "type": "string",
      "enum": [
        "curseforge",
        "modrinth",
        "ftb"
      ]
    }
  }
}
