{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallModRequest",
  "type": "object",
  "properties": {
    "expectedRevision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "mods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InstallModSelection"
      }
    }
  },
  "required": [
    "instanceId",
    "expectedRevision",
    "mods"
  ],
  "$defs": {
    "InstallModSelection": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        }
      },
      "required": [
        "provider",
        "projectId",
        "displayName"
      ]
    },
    "Provider": {
      "type": "string",
      "enum": [
        "curseforge",
        "modrinth",
        "ftb"
      ]
    }
  }
}
