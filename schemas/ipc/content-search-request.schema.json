{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentSearchRequest",
  "type": "object",
  "properties": {
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "$ref": "#/$defs/InstanceContentKindDto"
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "page": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "sort": {
      "$ref": "#/$defs/ModpackSortDto"
    }
  },
  "required": [
    "instanceId",
    "kind",
    "sort"
  ],
  "$defs": {
    "InstanceContentKindDto": {
      "type": "string",
      "enum": [
        "resourcePack",
        "shaderPack",
        "dataPack"
      ]
    },
    "ModpackSortDto": {
      "type": "string",
      "enum": [
        "relevance",
        "downloads",
        "updated",
        "newest"
      ]
    }
  }
}
