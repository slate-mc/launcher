{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerStatusSummary",
  "type": "object",
  "properties": {
    "address": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "descriptionSegments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ServerTextSegment"
      }
    },
    "favicon": {
      "type": [
        "string",
        "null"
      ]
    },
    "latencyMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "online": {
      "type": "boolean"
    },
    "playersMax": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "playersOnline": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "protocol": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "versionName": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "address",
    "online"
  ],
  "$defs": {
    "ServerTextSegment": {
      "type": "object",
      "properties": {
        "bold": {
          "type": "boolean"
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "italic": {
          "type": "boolean"
        },
        "obfuscated": {
          "type": "boolean"
        },
        "strikethrough": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "underlined": {
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ]
    }
  }
}
