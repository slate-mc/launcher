{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MinecraftAccountSummary",
  "type": "object",
  "properties": {
    "displayName": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "isDefault": {
      "type": "boolean"
    },
    "lastValidatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "profileId": {
      "type": "string",
      "format": "uuid"
    },
    "skinUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "#/$defs/MinecraftAccountStatusDto"
    }
  },
  "required": [
    "id",
    "profileId",
    "displayName",
    "status",
    "isDefault"
  ],
  "$defs": {
    "MinecraftAccountStatusDto": {
      "type": "string",
      "enum": [
        "ready",
        "reauthenticationRequired"
      ]
    }
  }
}
