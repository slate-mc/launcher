{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallContentRequest",
  "type": "object",
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InstallContentSelection"
      }
    },
    "expectedRevision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "$ref": "#/$defs/InstanceContentKindDto"
    },
    "worldName": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "instanceId",
    "expectedRevision",
    "kind",
    "content"
  ],
  "$defs": {
    "InstallContentSelection": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "iconUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectId": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        }
      },
      "required": [
        "provider",
        "projectId",
        "displayName"
      ]
    },
    "InstanceContentKindDto": {
      "type": "string",
      "enum": [
        "resourcePack",
        "shaderPack",
        "dataPack"
      ]
    },
    "Provider": {
      "type": "string",
      "enum": [
        "curseforge",
        "modrinth",
        "ftb"
      ]
    }
  }
}
